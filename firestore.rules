rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---------- Admin membership ----------
    // Cuma bisa dibaca oleh pemiliknya sendiri (untuk cek status admin dari
    // client). Penulisan sengaja diblokir total — UID admin pertama HARUS
    // ditambahkan manual lewat Firebase Console, supaya tidak ada jalan bagi
    // siapa pun untuk self-promote jadi admin dari browser.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- Afiliator ----------
    match /affiliates/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read, update: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow delete: if false;
    }

    // ---------- Referral dari form kontak (kontak.html) ----------
    match /referrals/{id} {
      // Pengunjung website belum tentu login, jadi create dibuka publik.
      // Catatan: ini berarti tidak ada validasi anti-spam otomatis di sisi
      // rules — kalau nanti disalahgunakan, pertimbangkan tambah App Check
      // atau reCAPTCHA di form kontak.
      allow create: if true;

      // Afiliator cuma boleh baca referral miliknya sendiri; admin boleh
      // baca semua.
      allow read: if isAdmin() || (
        request.auth != null &&
        get(/databases/$(database)/documents/affiliates/$(request.auth.uid)).data.code == resource.data.code
      );

      // Update status/komisi cuma boleh dari admin (lewat panel admin.html),
      // supaya afiliator tidak bisa ubah status closing atau nominal komisi
      // sendiri.
      allow update: if isAdmin();
      allow delete: if false;
    }

    function isApprovedAffiliate() {
      return request.auth != null &&
        get(/databases/$(database)/documents/affiliates/$(request.auth.uid)).data.status == 'active';
    }

    // ---------- Asesmen kebutuhan klien (Tool Asesmen) ----------
    match /assessments/{id} {
      // Hanya afiliator aktif yang boleh membuat, dan hanya atas namanya
      // sendiri, dengan status awal "baru" dan belum dihapus.
      allow create: if isApprovedAffiliate()
        && request.resource.data.affiliateUid == request.auth.uid
        && request.resource.data.status == 'baru'
        && request.resource.data.deleted == false;

      // Afiliator cuma boleh baca asesmen miliknya sendiri; admin boleh
      // baca semua.
      allow read: if isAdmin() || (request.auth != null && resource.data.affiliateUid == request.auth.uid);

      // Ubah status/catatan owner dan hapus (soft delete) cuma boleh admin —
      // afiliator tidak boleh mengubah asesmen setelah dibuat.
      allow update, delete: if isAdmin();
    }

    // ---------- Permintaan pencairan komisi ----------
    match /payoutRequests/{id} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
